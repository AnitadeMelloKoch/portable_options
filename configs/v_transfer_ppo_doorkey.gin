UncertainPPO.gamma = 0.99
UncertainPPO.lambd = 0.95
UncertainPPO.value_func_coef = 0.5
UncertainPPO.clip_eps_vf = 0.2
UncertainPPO.entropy_coef = 0.1
UncertainPPO.update_interval = 4096
UncertainPPO.minibatch_size = 64
UncertainPPO.epochs = 4
UncertainPPO.clip_eps = 0.2
UncertainPPO.max_grad_norm = 0.5
UncertainPPO.standardize_advantages = True
UncertainPPO.meta_vf_weight = 1.0
UncertainPPO.prior_scale = 1.0
UncertainPPO.z0 = 0.0

# Skill wrapper
PPOEnsembleVFAgent.num_actions = 7
PPOEnsembleVFAgent.num_vf_heads = 5
